# Rally web — local env example. Copy to .env.local and fill in.
# Real values live in 1Password / Supabase dashboard. DO NOT commit .env.local.

# Public (client + server). Used by @supabase/ssr in browser code.
NEXT_PUBLIC_SUPABASE_URL=https://qxpbnixvjtwckuedlrfj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Used by route handlers that need to bypass RLS
# (e.g. the SMS scheduler, the mutuals refresher).
# Never expose this to the browser. No NEXT_PUBLIC_ prefix on purpose.
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Site URL for share links + OAuth redirects in production.
#
# In dev, leave this blank or unset: /web/lib/site-url.ts reads the
# request's Host header at runtime and uses that. So if you access
# Rally at http://192.168.1.50:3000 from your laptop, the SMS invite
# link your friend gets points at the same LAN IP and resolves from
# their phone on the same WiFi. Hard-coding "localhost" here breaks
# that — phones can't resolve localhost.
#
# Only set this for prod deploys (e.g. https://rally.example.com).
NEXT_PUBLIC_SITE_URL=

# Twilio — used by /api/trips/[id]/invitations (Step 6) and by the
# Phase C RSVP nudge cadence. Server-only. The phone number is the
# Rally branded Twilio number.
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1xxx

# Gemini — used by /api/uploads/generate-cover to generate trip
# cover images from a planner-supplied prompt. Server-only.
GEMINI_API_KEY=xxx

# Anthropic — used by Phase B itinerary + meal AI generation.
# Server-only.
ANTHROPIC_API_KEY=sk-ant-xxx

# Giphy v1 — used by /api/gifs/search to power the activity-feed
# GIF picker. Free "beta" tier covers 1000 req/hour, 10k/day —
# plenty for alpha. Sign up at https://developers.giphy.com/dashboard/
# (create an SDK app, copy the API key).
# Leave unset to disable the GIF picker (the client falls back to a
# "GIF search not configured" message gracefully — photo upload +
# comments + reactions still work).
GIPHY_API_KEY=
